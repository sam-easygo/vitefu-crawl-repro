+/**
+ * @template T
+ * @param {Map<string, Promise<T>>} cache
+ * @param {string} key
+ * @param {() => Promise<T>} load
+ * @returns {Promise<T>}
+ */
+function once(cache, key, load) {
+  let value = cache.get(key)
+  if (!value) {
+    value = load()
+    cache.set(key, value)
+  }
+  return value
